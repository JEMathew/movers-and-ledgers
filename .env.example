MOVEBOOKS_ENV=local
MOVEBOOKS_PERSISTENCE_BACKEND=memory
MOVEBOOKS_STORAGE_BACKEND=memory
MOVEBOOKS_IDENTITY_MODE=demo
MOVEBOOKS_DEMO_IDENTITY_ENABLED=true
MOVEBOOKS_MODEL_PROVIDER_MODE=deterministic-only
MOVEBOOKS_LOGGING_MODE=structured
MOVEBOOKS_ANALYTICS_MODE=contracts-only
MOVEBOOKS_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_IDENTITY_MODE=demo
# Cloud-dev requires ALL of these, Firebase mode, GCS, Cloud SQL, demo=false,
# and explicit HTTPS CORS origins. Use attached service-account ADC, not key files.
MOVEBOOKS_GOOGLE_PROJECT=
MOVEBOOKS_SQL_INSTANCE=
MOVEBOOKS_SQL_DATABASE=
MOVEBOOKS_SQL_IAM_USER=
MOVEBOOKS_STORAGE_BUCKET=
# Public Firebase browser configuration (not a service credential). Cloud builds only.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Optional synthetic reasoning only: install .[agents], use normal Vertex ADC.
# Defaults remain credential-free. All five IDs must be chosen explicitly.
MOVEBOOKS_REASONING_PROJECT=
MOVEBOOKS_REASONING_LOCATION=asia-southeast1
MOVEBOOKS_REASONING_MODELS={}
MOVEBOOKS_REASONING_TIMEOUT_SECONDS=30
MOVEBOOKS_REASONING_MAX_RUNS=10
# API reports token counts; currency remains unknown without verified model prices.
